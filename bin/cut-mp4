#!/usr/bin/env bash
# Cut a clip from an already-converted MP4 (stream copy, no re-encode).
set -euo pipefail

C_RESET=$'\033[0m'
C_HEAD=$'\033[38;5;80m'
C_PICK=$'\033[38;5;176m'
C_MUTED=$'\033[38;5;245m'
C_PROMPT=$'\033[38;5;252m'
SEP='----------------------------------------'

banner() {
  echo
  echo "${C_HEAD}${SEP}${C_RESET}"
  echo "${C_HEAD}$1${C_RESET}"
  echo "${C_HEAD}${SEP}${C_RESET}"
}

picked() {
  echo "${C_PICK}✓ $1${C_RESET}"
}

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "need $1"; exit 1; }
}

need ffmpeg
need ffprobe
need python3

parseTime() {
  python3 -c '
import re, sys
s = sys.argv[1].strip()
if re.fullmatch(r"\d+(\.\d+)?", s):
    print(float(s))
    raise SystemExit(0)
parts = s.split(":")
try:
    if len(parts) == 2:
        m, sec = parts
        print(int(m) * 60 + float(sec))
    elif len(parts) == 3:
        h, m, sec = parts
        print(int(h) * 3600 + int(m) * 60 + float(sec))
    else:
        raise ValueError
except Exception:
    raise SystemExit(1)
' "$1"
}

fmtTime() {
  python3 -c '
import sys
t = max(0.0, float(sys.argv[1]))
h = int(t // 3600)
m = int((t % 3600) // 60)
s = t - h * 3600 - m * 60
print("%02d:%02d:%06.3f" % (h, m, s))
' "$1"
}

fmtTag() {
  python3 -c '
import sys
t = float(sys.argv[1])
h = int(t // 3600)
m = int((t % 3600) // 60)
s = int(round(t - h * 3600 - m * 60))
if h > 0:
    print("%02d%02d%02d" % (h, m, s))
else:
    print("%02d%02d" % (m, s))
' "$1"
}

askTime() {
  local prompt=$1
  local val sec
  while true; do
    printf "${C_PROMPT}%s${C_RESET} " "$prompt" >&2
    read -r val
    if sec=$(parseTime "$val" 2>/dev/null); then
      echo "$sec"
      return 0
    fi
    echo "Bad time. Use seconds (90), m:ss (1:30), or h:mm:ss (0:01:30)" >&2
  done
}

# Empty Enter → 0; otherwise same as askTime.
askTimeOrZero() {
  local prompt=$1
  local val sec
  while true; do
    printf "${C_PROMPT}%s${C_RESET} " "$prompt" >&2
    read -r val
    if [[ -z "$val" ]]; then
      echo "0"
      return 0
    fi
    if sec=$(parseTime "$val" 2>/dev/null); then
      echo "$sec"
      return 0
    fi
    echo "Bad time. Use seconds (90), m:ss (1:30), h:mm:ss — or Enter for 0" >&2
  done
}

pyOk() {
  python3 -c "print(1 if ($1) else 0)"
}

# Keep only SRT cues that start before clip length; clamp ends.
filterSrt() {
  python3 - "$1" "$2" "$3" <<'PY'
import re, sys
src_path, dst_path, len_s = sys.argv[1], sys.argv[2], sys.argv[3]
limit = float(len_s)
text = open(src_path, encoding="utf-8", errors="replace").read().strip()
if not text:
    open(dst_path, "w", encoding="utf-8").write("")
    raise SystemExit(0)

def parse_ts(s):
    h, m, rest = s.split(":")
    sec, ms = rest.split(",")
    return int(h) * 3600 + int(m) * 60 + int(sec) + int(ms) / 1000.0

def fmt_ts(t):
    t = max(0.0, t)
    h = int(t // 3600)
    m = int((t % 3600) // 60)
    s = t - h * 3600 - m * 60
    whole = int(s)
    ms = int(round((s - whole) * 1000))
    if ms == 1000:
        whole += 1
        ms = 0
    return "%02d:%02d:%02d,%03d" % (h, m, whole, ms)

blocks = re.split(r"\n\s*\n", text)
out = []
n = 0
for block in blocks:
    lines = block.strip().splitlines()
    if len(lines) < 2:
        continue
    idx = 1 if re.match(r"^\d+$", lines[0]) else 0
    if idx >= len(lines) or "-->" not in lines[idx]:
        continue
    left, right = [x.strip() for x in lines[idx].split("-->")]
    start_t, end_t = parse_ts(left), parse_ts(right)
    if start_t >= limit:
        continue
    if end_t > limit:
        end_t = limit
    if end_t <= start_t:
        continue
    n += 1
    body = "\n".join(lines[idx + 1 :])
    out.append("%d\n%s --> %s\n%s" % (n, fmt_ts(start_t), fmt_ts(end_t), body))
open(dst_path, "w", encoding="utf-8").write("\n\n".join(out) + ("\n" if out else ""))
PY
}

files=()
while IFS= read -r -d '' f; do
  files+=("$f")
done < <(find . -maxdepth 1 -type f -iname '*.mp4' -print0 | sort -z)

if [[ ${#files[@]} -eq 0 ]]; then
  echo "No MP4 files in $(pwd)"
  echo "This tool cuts already-converted MP4 only."
  exit 1
fi

banner "Found MP4 files:"
i=1
for f in "${files[@]}"; do
  name="${f#./}"
  if [[ "$name" == *_cut_* ]]; then
    printf "${C_PROMPT}%d.${C_RESET} %s ${C_MUTED}(already cut)${C_RESET}\n" "$i" "$name"
  else
    printf "${C_PROMPT}%d.${C_RESET} %s\n" "$i" "$name"
  fi
  i=$((i + 1))
done
echo "${C_HEAD}${SEP}${C_RESET}"

while true; do
  printf "${C_PROMPT}Select MP4 to cut (1-%d):${C_RESET} " "${#files[@]}"
  read -r pick
  if [[ "$pick" =~ ^[1-9][0-9]*$ ]] && [[ "$pick" -ge 1 && "$pick" -le ${#files[@]} ]]; then
    src="${files[$((pick - 1))]}"
    break
  fi
  echo "Please enter a number from 1 to ${#files[@]}"
done
picked "Selected: ${src#./}"

dur=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$src")
dur_h=$(fmtTime "$dur")
n_aud=$(ffprobe -v error -select_streams a -show_entries stream=index -of csv=p=0 "$src" | grep -c . || true)
n_sub=$(ffprobe -v error -select_streams s -show_entries stream=index -of csv=p=0 "$src" | grep -c . || true)
echo "${C_MUTED}Duration: ${dur_h}  ·  audio tracks: ${n_aud}  ·  softsubs: ${n_sub}${C_RESET}"

banner "Cut mode:"
echo "1. Enter start, then end time (default)"
echo "2. Keep first … of the file"
echo "3. Keep last … of the file"
echo "4. Drop from start and/or end"
echo "${C_MUTED}    e.g. skip intro/ads at the head, strip long credits at the tail${C_RESET}"
echo "${C_MUTED}Tip: times as 90  or  1:30  or  0:01:30${C_RESET}"
echo "${C_MUTED}Copy: start is exact; video may be black until the next keyframe (audio is fine).${C_RESET}"
echo "${C_MUTED}Keeps all audio + softsubs (subs rebuilt so the tail does not freeze).${C_RESET}"
echo "${C_HEAD}${SEP}${C_RESET}"
printf "${C_PROMPT}Your choice (1-4) [1]:${C_RESET} "
read -r mode
mode=${mode:-1}

start_sec=0
end_sec=0
len_sec=0
drop_head=0
drop_tail=0
mode_label=""

case "$mode" in
  1)
    while true; do
      start_sec=$(askTime "Start time:")
      [[ "$(pyOk "0 <= float('$start_sec') < float('$dur')")" == "1" ]] && break
      echo "Start must be >= 0 and < file duration ($dur_h)" >&2
    done
    picked "Start: $(fmtTime "$start_sec")"
    while true; do
      end_sec=$(askTime "End time:")
      [[ "$(pyOk "float('$start_sec') < float('$end_sec') <= float('$dur')")" == "1" ]] && break
      echo "End must be > start and <= file duration ($dur_h)" >&2
    done
    mode_label="start → end"
    picked "End: $(fmtTime "$end_sec")"
    ;;
  2)
    while true; do
      len_sec=$(askTime "Keep first how long:")
      [[ "$(pyOk "0 < float('$len_sec') <= float('$dur')")" == "1" ]] && break
      echo "Length must be > 0 and <= file duration ($dur_h)" >&2
    done
    start_sec=0
    end_sec=$len_sec
    mode_label="keep first"
    picked "Keep first $(fmtTime "$len_sec")"
    ;;
  3)
    while true; do
      len_sec=$(askTime "Keep last how long:")
      [[ "$(pyOk "0 < float('$len_sec') <= float('$dur')")" == "1" ]] && break
      echo "Length must be > 0 and <= file duration ($dur_h)" >&2
    done
    start_sec=$(python3 -c "print(float('$dur') - float('$len_sec'))")
    end_sec=$dur
    mode_label="keep last"
    picked "Keep last $(fmtTime "$len_sec")"
    ;;
  4)
    echo "${C_MUTED}Enter 0 or just press Enter to skip that side.${C_RESET}"
    while true; do
      drop_head=$(askTimeOrZero "Drop from start [0]:")
      drop_tail=$(askTimeOrZero "Drop from end [0]:")
      [[ "$(pyOk "float('$drop_head') >= 0 and float('$drop_tail') >= 0 and (float('$drop_head') > 0 or float('$drop_tail') > 0) and float('$drop_head') + float('$drop_tail') < float('$dur')")" == "1" ]] && break
      echo "Need at least one side > 0, both >= 0, and something left in the middle (duration $dur_h)" >&2
    done
    start_sec=$drop_head
    end_sec=$(python3 -c "print(float('$dur') - float('$drop_tail'))")
    mode_label="drop head/tail"
    picked "Drop start $(fmtTime "$drop_head") · drop end $(fmtTime "$drop_tail")"
    ;;
  *) echo "Bad mode choice"; exit 1 ;;
esac

len_sec=$(python3 -c "print(float('$end_sec') - float('$start_sec'))")

base=$(basename "$src")
base="${base%.*}"
case "$mode" in
  1) tag="$(fmtTag "$start_sec")-$(fmtTag "$end_sec")" ;;
  2) tag="keepfirst_$(fmtTag "$len_sec")" ;;
  3) tag="keeplast_$(fmtTag "$len_sec")" ;;
  4)
    if [[ "$(pyOk "float('$drop_head') > 0 and float('$drop_tail') > 0")" == "1" ]]; then
      tag="drop_$(fmtTag "$drop_head")_$(fmtTag "$drop_tail")"
    elif [[ "$(pyOk "float('$drop_head') > 0")" == "1" ]]; then
      tag="drop_$(fmtTag "$drop_head")_head"
    else
      tag="drop_$(fmtTag "$drop_tail")_end"
    fi
    ;;
esac
out="./${base}_cut_${tag}.mp4"

banner "Summary:"
echo "  input     $(basename "$src")"
echo "  output    ${out#./}"
echo "  mode      $mode_label"
if [[ "$mode" == "4" ]]; then
  echo "  drop      start $(fmtTime "$drop_head") · end $(fmtTime "$drop_tail")"
fi
echo "  start     $(fmtTime "$start_sec")"
echo "  end       $(fmtTime "$end_sec")"
echo "  length    $(fmtTime "$len_sec")"
echo "  tracks    audio ${n_aud} · softsubs ${n_sub} (rebuilt)"
echo "  encode    stream copy · chapters dropped"
echo "${C_HEAD}${SEP}${C_RESET}"
printf "${C_PROMPT}Start cut? [Y/n]:${C_RESET} "
read -r conf
conf=${conf:-Y}
case "$conf" in
  y|Y|"") ;;
  *) echo "Cancelled"; exit 0 ;;
esac

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# 1) Video + all audio (exact -ss after -i)
ffmpeg -hide_banner -y -i "$src" \
  -ss "$start_sec" -t "$len_sec" \
  -map '0:V' -map '0:a?' \
  -map_chapters -1 \
  -c copy \
  -avoid_negative_ts make_zero \
  -fflags +genpts \
  -movflags +faststart \
  "$tmp/av.mp4"

# 2) Each softsub → SRT (ss before -i) → clamp to length → mux as mov_text
ff_cmd=(ffmpeg -hide_banner -y -i "$tmp/av.mp4")
ff_map=(-map 0:V -map 0:a)
ff_meta=()
out_si=0
sub_i=0
while IFS= read -r _; do
  raw="$tmp/sub_${sub_i}.raw.srt"
  filt="$tmp/sub_${sub_i}.srt"
  lang=$(ffprobe -v error -select_streams "s:${sub_i}" -show_entries stream_tags=language -of default=nw=1:nk=1 "$src" 2>/dev/null || true)
  title=$(ffprobe -v error -select_streams "s:${sub_i}" -show_entries stream_tags=title -of default=nw=1:nk=1 "$src" 2>/dev/null || true)
  if ! ffmpeg -hide_banner -y -ss "$start_sec" -t "$len_sec" -i "$src" \
      -map "0:s:${sub_i}" -f srt "$raw" 2>/dev/null; then
    echo "${C_MUTED}skip subtitle #$((sub_i + 1)) (could not extract)${C_RESET}"
    sub_i=$((sub_i + 1))
    continue
  fi
  filterSrt "$raw" "$filt" "$len_sec"
  if [[ ! -s "$filt" ]]; then
    sub_i=$((sub_i + 1))
    continue
  fi
  in_idx=$((out_si + 1))
  ff_cmd+=(-i "$filt")
  ff_map+=(-map "${in_idx}:0")
  if [[ -n "$lang" ]]; then
    ff_meta+=(-metadata:s:s:${out_si} language="$lang")
  fi
  if [[ -n "$title" ]]; then
    ff_meta+=(-metadata:s:s:${out_si} title="$title")
  fi
  out_si=$((out_si + 1))
  sub_i=$((sub_i + 1))
done < <(ffprobe -v error -select_streams s -show_entries stream=index -of csv=p=0 "$src")

if [[ "$out_si" -eq 0 ]]; then
  mv -f "$tmp/av.mp4" "$out"
else
  ff_cmd+=("${ff_map[@]}" "${ff_meta[@]}"
    -c:v copy -c:a copy -c:s mov_text
    -map_chapters -1
    -movflags +faststart
    "$out")
  "${ff_cmd[@]}"
fi

xattr -c "$out" 2>/dev/null || true

out_dur=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$out" 2>/dev/null || echo "?")
out_a=$(ffprobe -v error -select_streams a -show_entries stream=index -of csv=p=0 "$out" | grep -c . || true)
out_s=$(ffprobe -v error -select_streams s -show_entries stream=index -of csv=p=0 "$out" | grep -c . || true)
picked "Done: ${out#./}"
echo "${C_MUTED}Output duration: $(fmtTime "$out_dur")  ·  audio ${out_a} · softsubs ${out_s}${C_RESET}"
