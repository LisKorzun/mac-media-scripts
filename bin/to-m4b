#!/usr/bin/env bash
# Build one M4B audiobook from chapter files in the current folder.
set -euo pipefail

C_RESET=$'\033[0m'
C_HEAD=$'\033[38;5;80m'
C_PICK=$'\033[38;5;176m'
C_MUTED=$'\033[38;5;245m'
C_PROMPT=$'\033[38;5;252m'
SEP='----------------------------------------'

banner() {
  echo
  echo "${C_HEAD}${SEP}${C_RESET}"
  echo "${C_HEAD}$1${C_RESET}"
  echo "${C_HEAD}${SEP}${C_RESET}"
}

picked() {
  echo "${C_PICK}✓ $1${C_RESET}"
}

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Need $1"; exit 1; }
}

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=../lib/book-audio.sh
source "$SCRIPT_DIR/../lib/book-audio.sh"
run_book_audio m4b
