#!/usr/bin/env bash
# mp4: write show, season, episode, year, genre, one cover, and each episode's own description.
# Episode title and description: 2sub.movie first, then Kinopoisk, then kino-teatr.ru.
# mp4 file name becomes "S01E01 · Episode title" in one language, same question as mkv.
# mkv: rename to "S01E01 · Episode title". One language for the folder, Russian or English.
# Nothing is written inside the mkv.
set -euo pipefail

C_RESET=$'\033[0m'
C_HEAD=$'\033[38;5;80m'
C_PICK=$'\033[38;5;176m'
C_MUTED=$'\033[38;5;245m'
C_PROMPT=$'\033[38;5;252m'
SEP='----------------------------------------'

COVER_DIR="${TAG_MOVIE_COVERS:-$HOME/Pictures/Video}"
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PY="$SCRIPT_DIR/../lib/tag-movie.py"

genres=(
  "Фильмы ужасов"
  "Фантастика"
  "Для всей семьи"
  "Психоз"
  "Триллеры"
  "Драмы"
  "Комедии"
  "Мультфильмы"
  "Биографии"
  "Катастрофы"
)

banner() {
  echo
  echo "${C_HEAD}${SEP}${C_RESET}"
  echo "${C_HEAD}$1${C_RESET}"
  echo "${C_HEAD}${SEP}${C_RESET}"
}

picked() {
  echo "${C_PICK}✓ $1${C_RESET}"
}

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "need $1"; exit 1; }
}

trim() {
  python3 -c 'import sys, unicodedata; print(unicodedata.normalize("NFC", sys.argv[1]).strip())' "$1"
}

is_skip() {
  local value
  value=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  [[ "$value" == "s" || "$value" == "skip" ]]
}

confirm_yes() {
  local ans lower
  while true; do
    printf "${C_PROMPT}%s [Y/n]:${C_RESET} " "$1"
    IFS= read -r ans || exit 1
    lower=$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]')
    case "$lower" in
      y|yes|"") return 0 ;;
      n|no) return 1 ;;
      *) echo "Enter y or n." ;;
    esac
  done
}

ask_required() {
  local value
  while true; do
    printf "${C_PROMPT}%s${C_RESET} " "$1"
    IFS= read -r value || exit 1
    value=$(trim "$value")
    if [[ -n "$value" ]]; then
      ANS=$value
      return 0
    fi
    echo "Enter something."
  done
}

ask_year() {
  local value
  while true; do
    printf "${C_PROMPT}Year:${C_RESET} "
    IFS= read -r value || exit 1
    value=$(trim "$value")
    if [[ "$value" =~ ^[0-9]{4}$ ]]; then
      ANS=$value
      return 0
    fi
    echo "Four digits, example: 2004"
  done
}

folder_guess() {
  local here name
  here=$(basename "$(pwd)")
  if [[ "$here" == "Apple" || "$here" == "LG" ]]; then
    name=$(basename "$(cd .. && pwd)")
  else
    name=$here
  fi
  name=${name% all}
  trim "$name"
}

parse_episode() {
  python3 - "$1" <<'PY'
import os, re, sys, unicodedata
name = unicodedata.normalize("NFC", os.path.splitext(os.path.basename(sys.argv[1]))[0])
match = re.match(r"^S(\d{1,2})E(\d{1,3})(?:\s*·\s*(.+))?$", name)
if not match:
    raise SystemExit(2)
season = int(match.group(1))
episode = int(match.group(2))
title = (match.group(3) or "").strip()
if not title:
    title = "S%02dE%02d" % (season, episode)
sys.stdout.write("%d\t%d\t%s\n" % (season, episode, title))
PY
}

show_genre_list() {
  local i g
  i=1
  for g in "${genres[@]}"; do
    printf "${C_PROMPT}%2d.${C_RESET} %s\n" "$i" "$g"
    i=$((i + 1))
  done
  printf "${C_PROMPT}%2d.${C_RESET} %s\n" "$i" "other"
  echo "${C_HEAD}${SEP}${C_RESET}"
  GENRE_OTHER=$i
}

apply_genre_number() {
  local ans=$1
  if [[ ! "$ans" =~ ^[1-9][0-9]*$ ]]; then
    return 1
  fi
  if ((10#$ans == GENRE_OTHER)); then
    while true; do
      ask_required "Genre word:"
      return 0
    done
  fi
  if ((10#$ans < 1 || 10#$ans > ${#genres[@]})); then
    return 1
  fi
  ANS=${genres[$((10#$ans - 1))]}
  return 0
}

pick_genre() {
  local ans
  banner "Genre"
  show_genre_list
  echo "${C_MUTED}One word for the whole show. Enter keeps it.${C_RESET}"
  while true; do
    if [[ -n "$genre_default" ]]; then
      printf "${C_PROMPT}Genre number [Enter = %s, s = skip]:${C_RESET} " "$genre_default"
    else
      printf "${C_PROMPT}Genre number (s to skip):${C_RESET} "
    fi
    IFS= read -r ans || exit 1
    ans=$(trim "$ans")
    if is_skip "$ans"; then
      ANS=""
      echo "Genre skipped."
      return 0
    fi
    if [[ -z "$ans" && -n "$genre_default" ]]; then
      ANS=$genre_default
      return 0
    fi
    if apply_genre_number "$ans"; then
      return 0
    fi
    echo "Enter a number from the list."
  done
}

pick_cover() {
  local query typed out first rest shown path idx choice
  while true; do
    if [[ ! -d "$COVER_DIR" ]]; then
      echo "No cover folder: $COVER_DIR"
    fi
    if [[ -n "$prev_query" ]]; then
      printf "${C_PROMPT}Cover search [%s] (s to skip):${C_RESET} " "$prev_query"
    else
      printf "${C_PROMPT}Cover search (s to skip):${C_RESET} "
    fi
    IFS= read -r typed || exit 1
    typed=$(trim "$typed")
    if is_skip "$typed"; then
      ANS_PATH=""
      ANS_NAME=""
      echo "Cover skipped."
      return 0
    fi
    if [[ -z "$typed" ]]; then
      if [[ -n "$prev_query" ]]; then
        query=$prev_query
      else
        echo "Type part of the png name."
        continue
      fi
    else
      query=$typed
    fi
    out=$(python3 - "$COVER_DIR" "$query" <<'PY'
import os, sys, unicodedata
folder, query = sys.argv[1], sys.argv[2]
query = unicodedata.normalize("NFC", query).casefold()
rows = []
for name in os.listdir(folder):
    if name.startswith("."):
        continue
    if not name.lower().endswith(".png"):
        continue
    path = os.path.join(folder, name)
    if not os.path.isfile(path):
        continue
    shown = unicodedata.normalize("NFC", name)
    if query in shown.casefold():
        rows.append((shown.casefold(), shown, path))
rows.sort()
if not rows:
    print("NONE")
    raise SystemExit(0)
if len(rows) > 30:
    print("MANY")
    raise SystemExit(0)
print("OK")
for _, shown, path in rows:
    sys.stdout.write("%s\t%s\n" % (shown, path))
PY
)
    first=${out%%$'\n'*}
    case "$first" in
      NONE)
        echo "No png matched."
        continue
        ;;
      MANY)
        echo "Too many matches. Type a longer piece of the name."
        continue
        ;;
      OK) ;;
      *)
        echo "Could not read covers."
        continue
        ;;
    esac
    rest=${out#"OK"$'\n'}
    matches=()
    match_paths=()
    while IFS=$'\t' read -r shown path; do
      [[ -z "${shown:-}" ]] && continue
      matches+=("$shown")
      match_paths+=("$path")
    done <<< "$rest"
    if [[ ${#matches[@]} -eq 0 ]]; then
      echo "No png matched."
      continue
    fi
    idx=0
    while [[ $idx -lt ${#matches[@]} ]]; do
      printf "${C_PROMPT}%2d.${C_RESET} %s\n" "$((idx + 1))" "${matches[$idx]}"
      idx=$((idx + 1))
    done
    echo "${C_HEAD}${SEP}${C_RESET}"
    while true; do
      printf "${C_PROMPT}Cover number (0 to search again, s to skip):${C_RESET} "
      IFS= read -r choice || exit 1
      choice=$(trim "$choice")
      if is_skip "$choice"; then
        ANS_PATH=""
        ANS_NAME=""
        echo "Cover skipped."
        return 0
      fi
      if [[ "$choice" == "0" ]]; then
        break
      fi
      if [[ ! "$choice" =~ ^[1-9][0-9]*$ ]] || ((10#$choice < 1 || 10#$choice > ${#matches[@]})); then
        echo "Enter a number from the list, or 0 to search again."
        continue
      fi
      ANS_PATH=${match_paths[$((10#$choice - 1))]}
      ANS_NAME=${matches[$((10#$choice - 1))]}
      prev_query=$query
      return 0
    done
  done
}

png_name() {
  python3 -c 'import re, sys, unicodedata
t = unicodedata.normalize("NFC", sys.argv[1])
t = re.sub(r"[/:\[\]?*\"<>|\\\\]", " ", t)
print(" ".join(t.split()) + ".png")' "$1"
}

save_poster() {
  local url=$1 ru=$2 dest name
  name=$(png_name "$ru")
  dest="$COVER_DIR/$name"
  echo "Downloading poster…"
  if ! python3 "$PY" fetch "$url" "$dest"; then
    echo "Could not download the poster."
    prev_query=$ru
    pick_cover
    return
  fi
  ANS_PATH=$dest
  ANS_NAME=$name
}

load_show() {
  local out line mode
  sure_line=""
  list_lines=()
  mode=""
  if ! out=$(python3 "$PY" show-search "$1"); then
    return 1
  fi
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    case "$line" in
      SURE|LIST|NONE)
        mode=$line
        continue
        ;;
    esac
    if [[ "$mode" == "SURE" && -z "$sure_line" ]]; then
      sure_line=$line
      continue
    fi
    list_lines+=("$line")
  done <<< "$out"
  if [[ ${#list_lines[@]} -eq 0 ]]; then
    return 2
  fi
  return 0
}

split_row() {
  local line=$1 rest
  PROP_RU=${line%%$'\t'*}
  rest=${line#*$'\t'}
  PROP_EN=${rest%%$'\t'*}
  rest=${rest#*$'\t'}
  PROP_YEAR=${rest%%$'\t'*}
  rest=${rest#*$'\t'}
  PROP_URL=${rest%%$'\t'*}
  if [[ "$rest" == *$'\t'* ]]; then
    PROP_ID=${rest#*$'\t'}
  else
    PROP_ID=""
  fi
  if [[ "$PROP_EN" == "-" || "$PROP_EN" == "$PROP_RU" ]]; then
    PROP_EN=""
  fi
}

show_found() {
  if [[ -n "$PROP_EN" ]]; then
    echo "Found: $PROP_RU / $PROP_EN · $PROP_YEAR"
  else
    echo "Found: $PROP_RU · $PROP_YEAR"
  fi
}

show_list() {
  local i line
  i=1
  for line in "${list_lines[@]}"; do
    split_row "$line"
    if [[ -n "$PROP_EN" ]]; then
      printf "${C_PROMPT}%2d.${C_RESET} %s / %s · %s\n" "$i" "$PROP_RU" "$PROP_EN" "$PROP_YEAR"
    else
      printf "${C_PROMPT}%2d.${C_RESET} %s · %s\n" "$i" "$PROP_RU" "$PROP_YEAR"
    fi
    i=$((i + 1))
  done
  echo "${C_HEAD}${SEP}${C_RESET}"
}

choose_show() {
  local choice
  while true; do
    if [[ -n "$sure_line" ]]; then
      split_row "$sure_line"
      show_found
      echo "${C_MUTED}Enter keeps this show. n searches another name. A number picks from the list.${C_RESET}"
    else
      echo "Several shows match. Pick one. 0 searches another name."
    fi
    show_list
    if [[ -n "$sure_line" ]]; then
      printf "${C_PROMPT}Show [Enter = 1]:${C_RESET} "
    else
      printf "${C_PROMPT}Show number:${C_RESET} "
    fi
    IFS= read -r choice || exit 1
    choice=$(trim "$choice")
    choice=$(printf '%s' "$choice" | tr '[:upper:]' '[:lower:]')
    if [[ -z "$choice" && -n "$sure_line" ]]; then
      split_row "$sure_line"
      return 0
    fi
    if [[ "$choice" == "n" || "$choice" == "no" || "$choice" == "0" ]]; then
      return 1
    fi
    if [[ "$choice" =~ ^[1-9][0-9]*$ ]] && ((10#$choice >= 1 && 10#$choice <= ${#list_lines[@]})); then
      split_row "${list_lines[$((10#$choice - 1))]}"
      return 0
    fi
    echo "Enter a number from the list."
  done
}

take_poster() {
  if [[ -n "$PROP_URL" ]]; then
    save_poster "$PROP_URL" "$PROP_RU"
    return
  fi
  echo "No poster on the show page."
  prev_query=$PROP_RU
  pick_cover
}

manual_show() {
  ask_required "Show name:"
  PROP_RU=$ANS
  PROP_EN=""
  PROP_URL=""
  PROP_ID=""
  ask_year
  PROP_YEAR=$ANS
  genre_default=""
  pick_genre
  PROP_GENRE=$ANS
  prev_query=$PROP_RU
  pick_cover
}

cover_jpeg() {
  local src=$1 tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/tag-show.XXXXXX") || return 1
  EMBED_COVER="$tmp.jpg"
  rm -f "$tmp"
  if ! sips -s format jpeg -s formatOptions 92 -s dpiWidth 72 -s dpiHeight 72 "$src" --out "$EMBED_COVER" >/dev/null; then
    rm -f "$EMBED_COVER"
    EMBED_COVER=""
    return 1
  fi
}

note_key=()
note_text=()
title_key=()
title_text=()

split_tabs() {
  local line=$1
  F1=""
  F2=""
  F3=""
  F4=""
  F5=""
  IFS=$'\t' read -r F1 F2 F3 F4 F5 <<< "$line"
}

load_notes() {
  local season=$1 en id out line nums="" i=0
  en=${PROP_EN:--}
  [[ -z "$en" ]] && en="-"
  id=${PROP_ID:--}
  [[ -z "$id" ]] && id="-"
  while [[ $i -lt ${#plan_season[@]} ]]; do
    if [[ "${plan_season[$i]}" == "$season" ]]; then
      nums+="${plan_episode[$i]},"
    fi
    i=$((i + 1))
  done
  if ! out=$(python3 "$PY" episode-notes "$id" "$season" "$nums" "$PROP_RU" "$en" "$PROP_YEAR" 2>/dev/null); then
    return 0
  fi
  while IFS= read -r line || [[ -n "${line:-}" ]]; do
    [[ -z "${line:-}" ]] && continue
    split_tabs "$line"
    [[ -z "$F1" || "$F1" == "NONE" ]] && continue
    if [[ -n "$F2" ]]; then
      title_key+=("$season:$F1")
      title_text+=("$F2")
    fi
    if [[ -n "$F3" ]]; then
      note_key+=("$season:$F1")
      note_text+=("$F3")
    fi
    if [[ -n "$F4" || -n "$F5" ]]; then
      name_key+=("$season:$F1")
      name_ru+=("$F4")
      name_en+=("$F5")
    fi
  done <<< "$out"
}

title_for() {
  local key=$1 i=0
  ANS=""
  while [[ $i -lt ${#title_key[@]} ]]; do
    if [[ "${title_key[$i]}" == "$key" ]]; then
      ANS=${title_text[$i]}
      return 0
    fi
    i=$((i + 1))
  done
}

note_for() {
  local key=$1 i=0
  ANS=""
  while [[ $i -lt ${#note_key[@]} ]]; do
    if [[ "${note_key[$i]}" == "$key" ]]; then
      ANS=${note_text[$i]}
      return 0
    fi
    i=$((i + 1))
  done
}

write_tags() {
  local src=$1 show=$2 title=$3 season=$4 episode=$5 year=$6 genre=$7 cover=$8 desc=$9
  local -a extra=()
  if [[ -n "$genre" ]]; then
    extra+=(-Genre="$genre")
  fi
  if [[ -n "$desc" ]]; then
    extra+=(-LongDescription="$desc" -Description="$desc")
  fi
  if [[ -n "$cover" ]]; then
    if ! cover_jpeg "$cover"; then
      echo "Could not prepare the cover."
      return 1
    fi
    extra+=(-CoverArt= "-CoverArt<=$EMBED_COVER")
  fi
  if [[ ${#extra[@]} -eq 0 ]]; then
    exiftool -q -m -overwrite_original -api LargeFileSupport=1 \
      -Title="$title" \
      -TVShow="$show" \
      -TVSeason#="$season" \
      -TVEpisode#="$episode" \
      -TVEpisodeID="$episode" \
      "-ContentCreateDate#=$year" \
      "-MediaType=TV Show" \
      "$src"
    return
  fi
  exiftool -q -m -overwrite_original -api LargeFileSupport=1 \
    -Title="$title" \
    -TVShow="$show" \
    -TVSeason#="$season" \
    -TVEpisode#="$episode" \
    -TVEpisodeID="$episode" \
    "-ContentCreateDate#=$year" \
    "-MediaType=TV Show" \
    "${extra[@]}" \
    "$src"
}

verify_tags() {
  python3 - "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" "$9" <<'PY'
import json, subprocess, sys
path, show, title, season, episode, genre, year, cover, desc = sys.argv[1:]
raw = subprocess.check_output([
    "exiftool", "-j", "-Title", "-TVShow", "-TVSeason", "-TVEpisode",
    "-Genre", "-ContentCreateDate", "-MediaType", "-LongDescription", path,
])
data = json.loads(raw.decode("utf-8"))[0]
bad = []
if data.get("Title") != title:
    bad.append("title")
if data.get("TVShow") != show:
    bad.append("show")
if str(data.get("TVSeason")) != str(int(season)):
    bad.append("season")
if str(data.get("TVEpisode")) != str(int(episode)):
    bad.append("episode")
if genre and data.get("Genre") != genre:
    bad.append("genre")
if str(data.get("ContentCreateDate")) != year:
    bad.append("year")
if data.get("MediaType") != "TV Show":
    bad.append("kind")
if desc and data.get("LongDescription") != desc:
    bad.append("description")
if cover:
    got = subprocess.check_output(["exiftool", "-b", "-CoverArt", path])
    with open(cover, "rb") as fh:
        want = fh.read()
    if got != want:
        bad.append("cover")
if bad:
    sys.stdout.write("Tag check failed: %s\n" % ", ".join(bad))
    raise SystemExit(1)
PY
}

lower_ext() {
  printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]'
}

ensure_mp4_tools() {
  if [[ "${checked_tools:-0}" -eq 1 ]]; then
    return 0
  fi
  checked_tools=1
  need exiftool
  need sips
  if [[ ! -d "$COVER_DIR" ]]; then
    echo "No cover folder yet: $COVER_DIR"
    echo "A poster download creates it. s skips the cover."
  fi
}

episode_filename() {
  python3 - "$1" "$2" "$3" "$4" <<'PY'
import os, re, sys, unicodedata
title, season, episode, src = sys.argv[1:5]
title = unicodedata.normalize("NFC", title)
title = re.sub(r'[\x00-\x1f\\/:*?"<>|]', " ", title)
title = " ".join(title.split()).strip(" .")
if not title:
    print("EMPTY")
    raise SystemExit(0)
ext = os.path.splitext(src)[1]
stem = "S%02dE%02d · %s" % (int(season), int(episode), title)
if len(stem) > 180:
    stem = stem[:180].rstrip(" .")
new = stem + ext
current = unicodedata.normalize("NFC", os.path.basename(src))
if current == new:
    print("SAME")
else:
    print(new)
PY
}

pick_title_lang() {
  local ans lower
  banner "Episode title"
  printf "${C_PROMPT}1.${C_RESET} Russian\n"
  printf "${C_PROMPT}2.${C_RESET} English\n"
  echo "${C_HEAD}${SEP}${C_RESET}"
  echo "${C_MUTED}One language for every file. Enter keeps Russian.${C_RESET}"
  while true; do
    printf "${C_PROMPT}Language [Enter = Russian]:${C_RESET} "
    IFS= read -r ans || exit 1
    lower=$(printf '%s' "$(trim "$ans")" | tr '[:upper:]' '[:lower:]')
    case "$lower" in
      ""|1|ru|rus|russian)
        TITLE_LANG=ru
        return 0
        ;;
      2|en|eng|english)
        TITLE_LANG=en
        return 0
        ;;
      *)
        echo "Enter 1 or 2."
        ;;
    esac
  done
}

name_key=()
name_ru=()
name_en=()

load_names() {
  local season=$1 show_en id out line nums="" i=0
  show_en=${PROP_EN:--}
  [[ -z "$show_en" ]] && show_en="-"
  id=${PROP_ID:--}
  [[ -z "$id" ]] && id="-"
  while [[ $i -lt ${#plan_season[@]} ]]; do
    if [[ "${plan_season[$i]}" == "$season" ]]; then
      nums+="${plan_episode[$i]},"
    fi
    i=$((i + 1))
  done
  if ! out=$(python3 "$PY" episode-notes "$id" "$season" "$nums" "$PROP_RU" "$show_en" "$PROP_YEAR" names 2>/dev/null); then
    return 0
  fi
  while IFS= read -r line || [[ -n "${line:-}" ]]; do
    [[ -z "${line:-}" ]] && continue
    split_tabs "$line"
    [[ -z "$F1" || "$F1" == "NONE" ]] && continue
    name_key+=("$season:$F1")
    name_ru+=("$F2")
    name_en+=("$F3")
  done <<< "$out"
}

name_for() {
  local key=$1 i=0
  ANS=""
  while [[ $i -lt ${#name_key[@]} ]]; do
    if [[ "${name_key[$i]}" == "$key" ]]; then
      if [[ "$TITLE_LANG" == "en" ]]; then
        ANS=${name_en[$i]}
      else
        ANS=${name_ru[$i]}
      fi
      return 0
    fi
    i=$((i + 1))
  done
}

rename_mkv() {
  local season i seen src new dest taken j change_n fail label
  name_key=()
  name_ru=()
  name_en=()
  pick_title_lang
  if [[ "$TITLE_LANG" == "en" ]]; then
    picked "Language: English"
  else
    picked "Language: Russian"
  fi
  echo "Looking up each episode…"
  seen="|"
  i=0
  while [[ $i -lt ${#plan_season[@]} ]]; do
    season=${plan_season[$i]}
    i=$((i + 1))
    case "$seen" in
      *"|$season|"*) continue ;;
    esac
    seen+="$season|"
    load_names "$season"
  done

  plan_new=()
  plan_keep=()
  banner "Preview"
  i=0
  while [[ $i -lt ${#plan_src[@]} ]]; do
    src=${plan_src[$i]}
    label=${src#./}
    name_for "${plan_season[$i]}:${plan_episode[$i]}"
    if [[ -z "$ANS" ]]; then
      echo "$label"
      echo "  ${C_MUTED}No title in this language. Name stays.${C_RESET}"
      plan_new+=("")
      plan_keep+=("stay")
      i=$((i + 1))
      continue
    fi
    new=$(episode_filename "$ANS" "${plan_season[$i]}" "${plan_episode[$i]}" "$src")
    if [[ "$new" == "EMPTY" || "$new" == "SAME" ]]; then
      echo "$label"
      if [[ "$new" == "SAME" ]]; then
        echo "  ${C_MUTED}Name already matches.${C_RESET}"
      else
        echo "  ${C_MUTED}This title cannot be a file name. Name stays.${C_RESET}"
      fi
      plan_new+=("")
      plan_keep+=("stay")
      i=$((i + 1))
      continue
    fi
    dest="./$new"
    taken=0
    if [[ -e "$dest" ]]; then
      taken=1
    fi
    j=0
    while [[ $j -lt ${#plan_new[@]} ]]; do
      if [[ -n "${plan_new[$j]}" && "${plan_new[$j]}" == "$new" ]]; then
        taken=1
      fi
      j=$((j + 1))
    done
    echo "$label"
    echo "  → $new"
    if [[ "$taken" -eq 1 ]]; then
      echo "  ${C_MUTED}A file with this name is already here. This one stays.${C_RESET}"
      plan_new+=("")
      plan_keep+=("stay")
    else
      plan_new+=("$new")
      plan_keep+=("move")
    fi
    i=$((i + 1))
  done
  if [[ "$skip_n" -gt 0 ]]; then
    echo "${C_MUTED}Skipped: $skip_n${C_RESET}"
  fi
  change_n=0
  i=0
  while [[ $i -lt ${#plan_keep[@]} ]]; do
    if [[ "${plan_keep[$i]}" == "move" ]]; then
      change_n=$((change_n + 1))
    fi
    i=$((i + 1))
  done
  echo
  if [[ "$change_n" -eq 0 ]]; then
    echo "No files to rename."
    exit 0
  fi
  echo "${C_MUTED}Only the file name changes.${C_RESET}"
  if ! confirm_yes "Rename these files?"; then
    echo "Cancelled"
    exit 0
  fi
  fail=0
  i=0
  while [[ $i -lt ${#plan_src[@]} ]]; do
    if [[ "${plan_keep[$i]}" != "move" ]]; then
      i=$((i + 1))
      continue
    fi
    src=${plan_src[$i]}
    dest="./${plan_new[$i]}"
    echo
    echo "Renaming: $(basename "$src")"
    if [[ -e "$dest" ]] || ! mv -n -- "$src" "$dest" || [[ -e "$src" ]]; then
      echo "Could not rename: $(basename "$src")"
      fail=$((fail + 1))
      i=$((i + 1))
      continue
    fi
    picked "$(basename "$dest")"
    i=$((i + 1))
  done
  echo
  if [[ "$fail" -ne 0 ]]; then
    echo "Done with errors"
    exit 1
  fi
  picked "Done"
  exit 0
}

need python3

files=()
while IFS= read -r -d '' f; do
  files+=("$f")
done < <(find . -maxdepth 1 -type f \( -iname '*.mp4' -o -iname '*.mkv' \) ! -name '.*' -print0 | sort -z)

if [[ ${#files[@]} -eq 0 ]]; then
  echo "No mp4 or mkv files in $(pwd)"
  exit 1
fi

has_mp4=0
has_mkv=0
for f in "${files[@]}"; do
  case "$(lower_ext "$f")" in
    mp4) has_mp4=1 ;;
    mkv) has_mkv=1 ;;
  esac
done
if [[ "$has_mkv" -eq 0 ]]; then
  ensure_mp4_tools
fi

if [[ "$has_mp4" -eq 1 && "$has_mkv" -eq 1 ]]; then
  banner "Video in this folder:"
elif [[ "$has_mkv" -eq 1 ]]; then
  banner "MKV in this folder:"
else
  banner "MP4 in this folder:"
fi
i=1
for f in "${files[@]}"; do
  printf "${C_PROMPT}%d.${C_RESET} %s\n" "$i" "${f#./}"
  i=$((i + 1))
done
echo "${C_HEAD}${SEP}${C_RESET}"
echo "${C_MUTED}Numbers (1 3 5), s02 for one season, or Enter for every video in this folder.${C_RESET}"

chosen=()
kind=""
while true; do
  printf "${C_PROMPT}Numbers, s02 for one season, or Enter for all (1-%d):${C_RESET} " "${#files[@]}"
  IFS= read -r pick || exit 1
  pick=$(trim "$pick")
  chosen=()
  ok=1
  token=$(printf '%s' "$pick" | tr '[:upper:]' '[:lower:]')
  if [[ -z "$pick" ]]; then
    chosen=("${files[@]}")
  elif [[ "$token" =~ ^s0*([0-9]{1,2})$ ]]; then
    code=$(printf 's%02de' "$((10#${BASH_REMATCH[1]}))")
    for src in "${files[@]}"; do
      low=$(printf '%s' "${src#./}" | tr '[:upper:]' '[:lower:]')
      if [[ "$low" == *"$code"* ]]; then
        chosen+=("$src")
      fi
    done
    if [[ ${#chosen[@]} -eq 0 ]]; then
      echo "No videos of that season in the list."
      continue
    fi
  else
    # shellcheck disable=SC2206
    nums=($pick)
    seen_ids=" "
    if [[ ${#nums[@]} -eq 0 ]]; then
      echo "Enter at least one number."
      continue
    fi
    for n in "${nums[@]}"; do
      if [[ ! "$n" =~ ^[1-9][0-9]*$ ]] || ((10#$n < 1 || 10#$n > ${#files[@]})); then
        echo "Bad number: $n"
        ok=0
        break
      fi
      case "$seen_ids" in
        *" $n "*) continue ;;
      esac
      seen_ids+="$n "
      chosen+=("${files[$((10#$n - 1))]}")
    done
    if [[ "$ok" -ne 1 ]]; then
      continue
    fi
    if [[ ${#chosen[@]} -eq 0 ]]; then
      echo "Enter at least one number."
      continue
    fi
  fi
  kind=""
  mixed=0
  for src in "${chosen[@]}"; do
    ext=$(lower_ext "$src")
    if [[ -z "$kind" ]]; then
      kind=$ext
    elif [[ "$kind" != "$ext" ]]; then
      mixed=1
      break
    fi
  done
  if [[ "$mixed" -eq 1 ]]; then
    echo "Pick either mp4 or mkv."
    continue
  fi
  break
done

RENAME=0
if [[ "$kind" == "mkv" ]]; then
  RENAME=1
else
  ensure_mp4_tools
fi

plan_src=()
plan_season=()
plan_episode=()
plan_title=()
skip_n=0
for src in "${chosen[@]}"; do
  if line=$(parse_episode "$src"); then
    plan_src+=("$src")
    plan_season+=("${line%%$'\t'*}")
    rest=${line#*$'\t'}
    plan_episode+=("${rest%%$'\t'*}")
    plan_title+=("${rest#*$'\t'}")
  else
    echo "Skip (not S01E01): ${src#./}"
    skip_n=$((skip_n + 1))
  fi
done
if [[ ${#plan_src[@]} -eq 0 ]]; then
  echo "No episode names like S01E01 · Title."
  exit 1
fi

banner "Show"
guess=$(folder_guess)
echo "${C_MUTED}Suggested from the folder name. Enter keeps it.${C_RESET}"
if [[ "$RENAME" -eq 1 ]]; then
  echo "${C_MUTED}Season and episode come from the file name. The file will be renamed.${C_RESET}"
  echo "${C_MUTED}No internet: s leaves the files unchanged.${C_RESET}"
else
  echo "${C_MUTED}Season and episode come from the file name. The episode title is added to the file name.${C_RESET}"
  echo "${C_MUTED}No internet: Enter types the year by hand. s leaves the files unchanged.${C_RESET}"
fi
searched=0
while true; do
  if [[ -n "$guess" ]]; then
    printf "${C_PROMPT}Show name [%s]:${C_RESET} " "$guess"
  else
    printf "${C_PROMPT}Show name:${C_RESET} "
  fi
  IFS= read -r typed || exit 1
  typed=$(trim "$typed")
  if [[ "$searched" -eq 1 ]] && is_skip "$typed"; then
    echo "Cancelled"
    exit 0
  fi
  if [[ -z "$typed" ]]; then
    if [[ "$searched" -eq 1 ]]; then
      if [[ "$RENAME" -eq 1 ]]; then
        echo "Type another name, or s to leave the files unchanged."
        continue
      fi
      manual_show
      break
    fi
    if [[ -z "$guess" ]]; then
      echo "Type the show name."
      continue
    fi
    typed=$guess
  fi
  guess=$typed
  echo "Looking up the show…"
  status=0
  load_show "$typed" || status=$?
  searched=1
  if [[ "$status" -eq 1 ]]; then
    if [[ "$RENAME" -eq 1 ]]; then
      echo "Kinopoisk did not answer. Type another name, or s to leave the files unchanged."
    else
      echo "Kinopoisk did not answer. Enter types the year by hand. s leaves the files unchanged."
    fi
    continue
  fi
  if [[ "$status" -ne 0 ]]; then
    if [[ "$RENAME" -eq 1 ]]; then
      echo "No show found. Type another name, or s to leave the files unchanged."
    else
      echo "No show found. Enter types the year by hand. s leaves the files unchanged."
    fi
    continue
  fi
  if choose_show; then
    break
  fi
  searched=0
done

if [[ "$RENAME" -eq 1 ]]; then
  picked "Show: $PROP_RU"
  rename_mkv
  exit 1
fi

if [[ -z "${PROP_GENRE:-}" ]]; then
  echo "Looking up the genre…"
  genre_default=""
  if g=$(python3 "$PY" show-genre "$PROP_RU" "$PROP_YEAR"); then
    if [[ -n "$g" && "$g" != "NONE" ]]; then
      genre_default=$g
    fi
  fi
  pick_genre
  PROP_GENRE=$ANS
  take_poster
fi
picked "Show: $PROP_RU"
if [[ -n "$PROP_GENRE" ]]; then
  picked "Genre: $PROP_GENRE"
else
  echo "Genre skipped."
fi
if [[ -n "$ANS_NAME" ]]; then
  picked "Cover: $ANS_NAME"
else
  echo "Cover skipped."
fi

printf "${C_PROMPT}Look up episode titles and descriptions? [Enter = yes, s = skip]:${C_RESET} "
IFS= read -r lookup || exit 1
lookup=$(trim "$lookup")
if is_skip "$lookup"; then
  echo "Episode titles and descriptions skipped."
else
  echo "Looking up each episode…"
seen="|"
i=0
while [[ $i -lt ${#plan_season[@]} ]]; do
  season=${plan_season[$i]}
  i=$((i + 1))
  case "$seen" in
    *"|$season|"*) continue ;;
  esac
  seen+="$season|"
  load_notes "$season"
done
fi

pick_title_lang
if [[ "$TITLE_LANG" == "en" ]]; then
  picked "File name: English"
else
  picked "File name: Russian"
fi
if [[ ${#name_key[@]} -eq 0 ]]; then
  echo "Looking up episode titles…"
  name_key=()
  name_ru=()
  name_en=()
  seen="|"
  i=0
  while [[ $i -lt ${#plan_season[@]} ]]; do
    season=${plan_season[$i]}
    i=$((i + 1))
    case "$seen" in
      *"|$season|"*) continue ;;
