banner "Preview"
plan_file_new=()
i=0
while [[ $i -lt ${#plan_src[@]} ]]; do
  title_for "${plan_season[$i]}:${plan_episode[$i]}"
  if [[ -z "$ANS" ]]; then
    ANS=${plan_title[$i]}
  fi
  printf "S%02dE%02d · %s\n" "${plan_season[$i]}" "${plan_episode[$i]}" "$ANS"
  echo "  ${plan_src[$i]#./}"
  name_for "${plan_season[$i]}:${plan_episode[$i]}"
  new=""
  if [[ -n "$ANS" ]]; then
    new=$(episode_filename "$ANS" "${plan_season[$i]}" "${plan_episode[$i]}" "${plan_src[$i]}")
  fi
  if [[ -z "$ANS" ]]; then
    echo "  ${C_MUTED}No title in this language. Name stays.${C_RESET}"
  fi
  if [[ -z "$new" || "$new" == "EMPTY" || "$new" == "SAME" ]]; then
    plan_file_new+=("")
  else
    dest="./$new"
    taken=0
    if [[ -e "$dest" ]]; then
      taken=1
    fi
    j=0
    while [[ $j -lt ${#plan_file_new[@]} ]]; do
      if [[ -n "${plan_file_new[$j]}" && "${plan_file_new[$j]}" == "$new" ]]; then
        taken=1
      fi
      j=$((j + 1))
    done
    if [[ "$taken" -eq 1 ]]; then
      echo "  ${C_MUTED}A file with this name is already here. This name stays.${C_RESET}"
      plan_file_new+=("")
    else
      echo "  → $new"
      plan_file_new+=("$new")
    fi
  fi
  genre_shown=$PROP_GENRE
  cover_shown=$ANS_NAME
  if [[ -z "$genre_shown" ]]; then
    genre_shown="no genre"
  fi
  if [[ -z "$cover_shown" ]]; then
    cover_shown="no cover"
  fi
  echo "  ${PROP_RU} · ${genre_shown} · ${PROP_YEAR} · ${cover_shown}"
  note_for "${plan_season[$i]}:${plan_episode[$i]}"
  if [[ -n "$ANS" ]]; then
    echo "  $ANS"
  else
    echo "  ${C_MUTED}No description for this episode.${C_RESET}"
  fi
  i=$((i + 1))
done
if [[ "$skip_n" -gt 0 ]]; then
  echo "${C_MUTED}Skipped: $skip_n${C_RESET}"
fi
echo
echo "${C_MUTED}The episode title is added to the file name. The same cover is written into each file.${C_RESET}"
if ! confirm_yes "Write the show into these files?"; then
  echo "Cancelled"
  exit 0
fi

if command -v caffeinate >/dev/null 2>&1; then
  caffeinate -is -w $$ >/dev/null 2>&1 &
  picked "Keeping Mac awake until this script finishes (caffeinate -is)"
fi

fail=0
i=0
while [[ $i -lt ${#plan_src[@]} ]]; do
  file_i=$i
  src=${plan_src[$i]}
  season=${plan_season[$i]}
  episode=${plan_episode[$i]}
  title_for "$season:$episode"
  if [[ -n "$ANS" ]]; then
    title=$ANS
  else
    title=${plan_title[$i]}
  fi
  note_for "$season:$episode"
  desc=$ANS
  i=$((i + 1))
  echo
  echo "Writing tags: $(basename "$src")"
  EMBED_COVER=""
  if ! write_tags "$src" "$PROP_RU" "$title" "$season" "$episode" "$PROP_YEAR" "$PROP_GENRE" "$ANS_PATH" "$desc"; then
    rm -f "$EMBED_COVER"
    echo "Could not write tags: $(basename "$src")"
    fail=$((fail + 1))
    continue
  fi
  if ! verify_tags "$src" "$PROP_RU" "$title" "$season" "$episode" "$PROP_GENRE" "$PROP_YEAR" "$EMBED_COVER" "$desc"; then
    rm -f "$EMBED_COVER"
    fail=$((fail + 1))
    continue
  fi
  rm -f "$EMBED_COVER"
  xattr -c -- "$src" 2>/dev/null || true
  new_name=${plan_file_new[$file_i]}
  if [[ -n "$new_name" ]]; then
    dest="./$new_name"
    if [[ -e "$dest" ]] || ! mv -n -- "$src" "$dest" || [[ -e "$src" ]]; then
      echo "Could not rename: $(basename "$src")"
      fail=$((fail + 1))
      continue
    fi
    picked "$(basename "$dest")"
  else
    picked "$(basename "$src")"
  fi
done

echo
if [[ "$fail" -ne 0 ]]; then
  echo "Done with errors"
  exit 1
fi
picked "Done"
echo "${C_MUTED}In the TV app, add a file that is not in the library yet and see if it is under TV Shows.${C_RESET}"
