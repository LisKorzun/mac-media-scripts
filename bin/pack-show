#!/usr/bin/env bash
# Flatten season folders into one folder.
# "01. Title.ext" or "Show.S01E01.Title….ext" → "S01E01 · Title.ext".
# No episode title → "S01E01.ext".
set -euo pipefail

C_RESET=$'\033[0m'
C_HEAD=$'\033[38;5;80m'
C_PICK=$'\033[38;5;176m'
C_MUTED=$'\033[38;5;245m'
C_PROMPT=$'\033[38;5;252m'
C_WARN=$'\033[38;5;215m'
SEP='----------------------------------------'

banner() {
  echo
  echo "${C_HEAD}${SEP}${C_RESET}"
  echo "${C_HEAD}$1${C_RESET}"
  echo "${C_HEAD}${SEP}${C_RESET}"
}

picked() {
  echo "${C_PICK}✓ $1${C_RESET}"
}

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "need $1"; exit 1; }
}

need python3

plan_show() {
  python3 - "$1" <<'PY'
import os, re, sys

EXTS = {".mkv", ".mp4", ".mov", ".m4v", ".avi", ".webm", ".ts", ".m2ts"}
# Season mark anywhere in the folder name: s01, Season 2, сезон 3, Show.S01.
SEASON_RE = re.compile(
    r"(?:^|[^0-9A-Za-zА-Яа-яЁё])(?:season|сезон|s)[ ._-]*(\d{1,2})(?!\d)",
    re.I,
)
# "2 сезон" / "02 season"
SEASON_TAIL_RE = re.compile(
    r"(?:^|[^0-9A-Za-zА-Яа-яЁё])(\d{1,2})(?!\d)[ ._-]*(?:season|сезон)(?![A-Za-zА-Яа-яЁё])",
    re.I,
)
CODE_RE = re.compile(
    r"(?:^|[^0-9A-Za-zА-Яа-яЁё])[Ss](\d{1,2})[ ._-]*[Ee](\d{1,3})(?!\d)"
    r"(?:[ ._-]*[Ee](\d{1,3})(?!\d))?"
)
X_RE = re.compile(
    r"(?:^|[^0-9A-Za-zА-Яа-яЁё])(\d{1,2})x(\d{1,3})(?!\d)",
    re.I,
)
LEAD_RE = re.compile(r"^(\d+)\.\s*(.*)$")
# Words that end the episode title in a scene name (1080p, WEB-DL, AMZN, …).
RELEASE_RE = re.compile(
    r"^(?:"
    r"\d{3,4}p|4k|uhd|hdr|"
    r"web|web-?dl|web-?rip|hdtv|hdtvrip|pdtv|"
    r"blu-?ray|bdrip|brrip|bdremux|remux|dvdrip|hdrip|"
    r"amzn|amazon|nf|netflix|dsnp|hmax|hulu|atvp|itunes|"
    r"x264|x265|h264|h265|hevc|avc|xvid|divx|10bit|8bit|"
    r"aac\d*|ac3|eac3|ddp\d*|dd\d+|dts(?:-hd)?|truehd"
    r")$",
    re.I,
)


def season_number(name):
    m = SEASON_RE.search(name)
    if m:
        return int(m.group(1))
    m = SEASON_TAIL_RE.search(name)
    if m:
        return int(m.group(1))
    return None


def scene_title(tail):
    tail = re.sub(r"^(?:[ ._-]*[Ee]\d{1,3}(?!\d))+", "", tail)
    tail = tail.strip(" ._-")
    if not tail:
        return ""
    parts = [p for p in re.split(r"[._\s]+", tail) if p]
    kept = []
    i = 0
    while i < len(parts):
        piece = parts[i].strip("-")
        if not piece:
            i += 1
            continue
        nxt = parts[i + 1].lower() if i + 1 < len(parts) else ""
        if RELEASE_RE.match(piece) or (piece.lower() in {"h", "x"} and nxt in {"264", "265", "266"}):
            break
        kept.append(piece)
        i += 1
    return re.sub(r"\s+", " ", " ".join(kept)).strip(" -")


def dest_name(season, episode, episode2, title, ext):
    name = "S%02dE%02d" % (season, episode)
    if episode2:
        name += "E%02d" % episode2
    if title:
        name += " · " + title
    return name + ext


def parse_episode(fn, folder_season):
    stem, ext = os.path.splitext(fn)
    if ext.lower() not in EXTS:
        return None
    m = CODE_RE.search(stem)
    if m:
        episode2 = int(m.group(3)) if m.group(3) else None
        title = scene_title(stem[m.end():])
        return int(m.group(1)), int(m.group(2)), episode2, title, ext
    m = X_RE.search(stem)
    if m:
        title = scene_title(stem[m.end():])
        return int(m.group(1)), int(m.group(2)), None, title, ext
    if folder_season is None:
        return None
    m = LEAD_RE.match(stem)
    if not m:
        return None
    return folder_season, int(m.group(1)), None, m.group(2).strip(), ext


def collect(show):
    rows = []
    skipped = []
    try:
        names = sorted(os.listdir(show))
    except OSError:
        return rows, skipped
    for name in names:
        if name.startswith("."):
            continue
        path = os.path.join(show, name)
        if not os.path.isdir(path):
            continue
        season = season_number(name)
        if season is None:
            continue
        for fn in sorted(os.listdir(path)):
            if fn.startswith("."):
                continue
            src = os.path.join(path, fn)
            if not os.path.isfile(src):
                continue
            parsed = parse_episode(fn, season)
            if not parsed:
                skipped.append(src)
                continue
            file_season, episode, episode2, title, ext = parsed
            dest = dest_name(file_season, episode, episode2, title, ext)
            rows.append((file_season, episode, src, dest))
    rows.sort()
    return rows, skipped


def self_test():
    assert season_number("s01") == 1
    assert season_number("s04 extra") == 4
    assert season_number("Season 2") == 2
    assert season_number("сезон 3") == 3
    assert season_number("Desperate.Housewives.S01.") == 1
    assert season_number("Show.Season.01.1080p") == 1
    assert season_number("Show.Name.S02.1080p.AMZN") == 2
    assert season_number("2 сезон") == 2
    assert season_number("Subs") is None
    assert season_number("Series.01") is None

    def one(folder, fn):
        got = parse_episode(fn, season_number(folder))
        assert got, (folder, fn)
        return dest_name(*got)

    assert one("s01", "01. Пилот.mkv") == "S01E01 · Пилот.mkv"
    assert one("Season 2", "03. Title.mkv") == "S02E03 · Title.mkv"
    assert one("s01", "01. Часть 1. Вступление.mkv") == "S01E01 · Часть 1. Вступление.mkv"
    long = "Desperate.Housewives.S01E12.Every.Day.a.Little.Death.1080p.AMZN.WEB-DL.Rus.Eng_BenderBEST.mkv"
    assert one("Desperate.Housewives.S01.", long) == "S01E12 · Every Day a Little Death.mkv"
    who = "Desperate.Housewives.S01E04.Who's.That.Woman.1080p.AMZN.WEB-DL.Rus.Eng_BenderBEST.mkv"
    assert one("Desperate.Housewives.S01.", who) == "S01E04 · Who's That Woman.mkv"
    wont = "Desperate.Housewives.S01E17.There.Won't.Be.Trumpets.1080p.AMZN.WEB-DL.mkv"
    assert one("Desperate.Housewives.S01.", wont) == "S01E17 · There Won't Be Trumpets.mkv"
    assert one("Show.S02.", "Show.S02E05.1080p.AMZN.WEB-DL.mkv") == "S02E05.mkv"
    assert one("s01", "Show.S01E01.mkv") == "S01E01.mkv"
    assert parse_episode("readme.txt", 1) is None
    assert parse_episode("01.mkv", 1) is None

    import tempfile, shutil
    root = tempfile.mkdtemp()
    try:
        show = os.path.join(root, "Show")
        season = os.path.join(show, "Desperate.Housewives.S01.")
        os.makedirs(season)
        open(os.path.join(season, long), "w").close()
        legacy = os.path.join(show, "s02")
        os.makedirs(legacy)
        open(os.path.join(legacy, "04. Финал.mkv"), "w").close()
        os.makedirs(os.path.join(show, "Subs"))
        rows, skipped = collect(show)
        dests = [row[3] for row in rows]
        assert dests == [
            "S01E12 · Every Day a Little Death.mkv",
            "S02E04 · Финал.mkv",
        ], dests
        assert skipped == []
    finally:
        shutil.rmtree(root)
    print("ok")


def main(arg):
    if arg == "--self-test":
        self_test()
        return
    rows, skipped = collect(arg)
    seen = {}
    for season, episode, src, dest in rows:
        flag = "dup" if dest in seen else "ok"
        seen[dest] = src
        sys.stdout.write("%s\t%d\t%d\t%s\t%s\n" % (flag, season, episode, src, dest))
    for src in skipped:
        sys.stderr.write("skip\t%s\n" % src)
    if not rows:
        raise SystemExit(2)


main(sys.argv[1])
PY
}

if [[ "${1:-}" == "--self-test" ]]; then
  plan_show --self-test
  exit $?
fi

here=$(pwd)
show=""
if plan_show "$here" >/dev/null 2>/dev/null; then
  show="$here"
else
  dirs=()
  while IFS= read -r -d '' d; do
    dirs+=("$d")
  done < <(find . -maxdepth 1 -mindepth 1 -type d ! -name '.*' -print0 | sort -z)
  picks=()
  for d in "${dirs[@]+"${dirs[@]}"}"; do
    if plan_show "$d" >/dev/null 2>/dev/null; then
      picks+=("$d")
    fi
  done
  if [[ ${#picks[@]} -eq 0 ]]; then
    echo "No season folders here."
    echo "cd into the show folder (s01 or Show.S01 inside) or into its parent, then run pack-show."
    exit 1
  fi
  banner "Shows with season folders:"
  i=1
  for d in "${picks[@]}"; do
    printf "${C_PROMPT}%d.${C_RESET} %s\n" "$i" "${d#./}"
    i=$((i + 1))
  done
  echo "${C_HEAD}${SEP}${C_RESET}"
  while true; do
    printf "${C_PROMPT}Select show (1-%d):${C_RESET} " "${#picks[@]}"
    read -r pick
    if [[ "$pick" =~ ^[1-9][0-9]*$ ]] && [[ "$pick" -ge 1 && "$pick" -le ${#picks[@]} ]]; then
      show="${picks[$((pick - 1))]}"
      break
    fi
    echo "Please enter a number from 1 to ${#picks[@]}"
  done
fi
picked "Show: ${show#./}"

plan=$(mktemp)
skips=$(mktemp)
trap 'rm -f "$plan" "$skips"' EXIT
set +e
plan_show "$show" >"$plan" 2>"$skips"
rc=$?
set -e
if [[ "$rc" -ne 0 ]]; then
  echo "No episodes matched (need a season folder and files like 01. Title.mkv or Show.S01E01.Title.mkv)."
  exit 1
fi

parent=$(cd "$show/.." && pwd)
base=$(basename "$show")
default="${base} all"

banner "Preview:"
n=0
dups=0
while IFS=$'\t' read -r flag season episode src dest; do
  [[ -z "${flag:-}" ]] && continue
  n=$((n + 1))
  rel=${src#"$show"/}
  if [[ "$flag" == "dup" ]]; then
    dups=$((dups + 1))
    printf "${C_WARN}%s${C_RESET}\n" "  $rel  →  $dest  (duplicate, will skip)"
  else
    printf "  %s\n" "$rel  →  $dest"
  fi
done <"$plan"
echo "${C_HEAD}${SEP}${C_RESET}"
echo "${C_MUTED}Episodes: $n. With a title: SxxExx · title. Without a title: SxxExx.${C_RESET}"
skip_n=0
if [[ -s "$skips" ]]; then
  while IFS=$'\t' read -r tag path; do
    [[ "$tag" == "skip" ]] || continue
    skip_n=$((skip_n + 1))
    echo "${C_WARN}skip  ${path#"$show"/}${C_RESET}"
  done <"$skips"
fi
if [[ "$dups" -gt 0 ]]; then
  echo "${C_WARN}$dups duplicate name(s) will be left in place.${C_RESET}"
fi

banner "Output folder"
echo "${C_MUTED}Created next to the show folder:${C_RESET}"
echo "${C_MUTED}  ${parent}/${C_RESET}"
echo "${C_MUTED}Files are moved, not copied. Empty season folders stay.${C_RESET}"
echo "${C_HEAD}${SEP}${C_RESET}"
printf "${C_PROMPT}Folder name [%s]:${C_RESET} " "$default"
read -r out_name
out_name=${out_name:-$default}
if [[ "$out_name" == *"/"* || "$out_name" == "." || "$out_name" == ".." || -z "$out_name" ]]; then
  echo "Bad folder name"
  exit 1
fi
dest_dir="${parent}/${out_name}"
if [[ "$dest_dir" == "$show" || "$dest_dir" == "$(cd "$show" && pwd)" ]]; then
  echo "Output folder must be different from the show folder"
  exit 1
fi
picked "Output: ${dest_dir}"

printf "${C_PROMPT}Move %d file(s)? [Y/n]:${C_RESET} " "$n"
read -r conf
conf=${conf:-Y}
case "$conf" in
  y|Y|"") ;;
  *) echo "Cancelled"; exit 0 ;;
esac

mkdir -p "$dest_dir"
moved=0
left=0
while IFS=$'\t' read -r flag season episode src dest; do
  [[ -z "${flag:-}" ]] && continue
  if [[ "$flag" == "dup" ]]; then
    left=$((left + 1))
    continue
  fi
  target="${dest_dir}/${dest}"
  if [[ -e "$target" ]]; then
    echo "${C_WARN}exists, skip: $dest${C_RESET}"
    left=$((left + 1))
    continue
  fi
  mv "$src" "$target"
  moved=$((moved + 1))
done <"$plan"

picked "Moved $moved file(s) → ${dest_dir}"
if [[ "$left" -gt 0 ]]; then
  echo "${C_MUTED}Left in place: $left${C_RESET}"
fi
if [[ "$skip_n" -gt 0 ]]; then
  echo "${C_MUTED}Skipped (not an episode name): $skip_n${C_RESET}"
fi
