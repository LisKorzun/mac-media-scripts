#!/usr/bin/env bash
# Glue an external subtitle file onto a copy of the video.
set -euo pipefail

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Need $1"; exit 1; }
}

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
need ffmpeg
need ffprobe
need python3
exec python3 "$SCRIPT_DIR/../lib/add-subs.py"
