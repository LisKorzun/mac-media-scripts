#!/usr/bin/env bash
# Fix lookalike letters in text subtitles of ready mp4/mkv. Video and audio are copied.
set -euo pipefail

C_RESET=$'\033[0m'
C_HEAD=$'\033[38;5;80m'
C_PICK=$'\033[38;5;176m'
C_MUTED=$'\033[38;5;245m'
C_PROMPT=$'\033[38;5;252m'
SEP='----------------------------------------'

banner() {
  echo
  echo "${C_HEAD}${SEP}${C_RESET}"
  echo "${C_HEAD}$1${C_RESET}"
  echo "${C_HEAD}${SEP}${C_RESET}"
}

picked() {
  echo "${C_PICK}✓ $1${C_RESET}"
}

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Need $1"; exit 1; }
}

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PY="$SCRIPT_DIR/../lib/fix-subs.py"

need ffmpeg
need ffprobe
need python3

files=()
while IFS= read -r -d '' f; do
  files+=("$f")
done < <(find . -maxdepth 1 -type f \( -iname '*.mp4' -o -iname '*.mkv' -o -iname '*.m4v' -o -iname '*.mov' \) -print0 | sort -z)

if [[ ${#files[@]} -eq 0 ]]; then
  echo "No mp4 or mkv files in $(pwd)"
  exit 1
fi

banner "Found video files:"
i=1
for f in "${files[@]}"; do
  printf "${C_PROMPT}%d.${C_RESET} %s\n" "$i" "${f#./}"
  i=$((i + 1))
done
echo "${C_HEAD}${SEP}${C_RESET}"
echo "${C_MUTED}Pick one or more numbers separated by spaces (example: 1 3 5).${C_RESET}"

while true; do
  printf "${C_PROMPT}Select video number(s) (1-%d):${C_RESET} " "${#files[@]}"
  read -r pick
  ok=1
  # shellcheck disable=SC2206
  nums=($pick)
  if [[ ${#nums[@]} -eq 0 ]]; then
    echo "Enter at least one number."
    continue
  fi
  for n in "${nums[@]}"; do
    if ! [[ "$n" =~ ^[0-9]+$ ]] || ((n < 1 || n > ${#files[@]})); then
      echo "Bad number: $n"
      ok=0
      break
    fi
  done
  [[ "$ok" -eq 1 ]] && break
done

banner "Preview"
total_words=0
for n in "${nums[@]}"; do
  src="${files[$((n - 1))]}"
  echo "${src#./}"
  lines=$(python3 "$PY" count "$src")
  if [[ "$lines" == "none" ]]; then
    echo "  no text subtitles"
    continue
  fi
  while IFS=$'\t' read -r kind lang words status; do
    [[ -z "${kind:-}" ]] && continue
    if [[ "$kind" == "image" ]]; then
      echo "  image subtitles: left as is"
    elif [[ "$status" == "skip-lang" ]]; then
      echo "  no rus/eng mark ($lang): left as is"
    else
      echo "  $lang: $words word(s)"
      total_words=$((total_words + words))
    fi
  done <<< "$lines"
done

if [[ "$total_words" -eq 0 ]]; then
  picked "Nothing to fix"
  exit 0
fi

echo
printf "${C_PROMPT}Fix these files? [Y/n]:${C_RESET} "
read -r conf
conf=${conf:-Y}
case "$conf" in
  y|Y|"") ;;
  *) echo "Cancelled"; exit 0 ;;
esac

for n in "${nums[@]}"; do
  src="${files[$((n - 1))]}"
  echo
  echo "${src#./}"
  python3 "$PY" apply "$src"
  xattr -c "$src" 2>/dev/null || true
done

picked "Done"
